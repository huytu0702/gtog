ease-specific specialists, such as digestive health experts in anal cancer care).", "role": "assistant", "tool_calls": null, "function_call": null}, "provider_specific_fields": {"native_finish_reason": "stop"}}], "usage": {"completion_tokens": 724, "prompt_tokens": 2281, "total_tokens": 3005, "completion_tokens_details": {"accepted_prediction_tokens": null, "audio_tokens": null, "reasoning_tokens": 0, "rejected_prediction_tokens": null, "text_tokens": null}, "prompt_tokens_details": {"audio_tokens": null, "cached_tokens": 0, "text_tokens": null, "image_tokens": null}}, "service_tier": null}}}