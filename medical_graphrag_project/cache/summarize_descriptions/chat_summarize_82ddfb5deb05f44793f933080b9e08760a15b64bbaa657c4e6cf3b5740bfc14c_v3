n assays in conjunction with the **BIOPSY SAMPLE**.", "role": "assistant", "tool_calls": null, "function_call": null}, "provider_specific_fields": {"native_finish_reason": "stop"}}], "usage": {"completion_tokens": 381, "prompt_tokens": 538, "total_tokens": 919, "completion_tokens_details": {"accepted_prediction_tokens": null, "audio_tokens": null, "reasoning_tokens": 0, "rejected_prediction_tokens": null, "text_tokens": null}, "prompt_tokens_details": {"audio_tokens": null, "cached_tokens": 0, "text_tokens": null, "image_tokens": null}}, "service_tier": null}}}