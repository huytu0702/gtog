# API Configuration
GRAPHRAG_API_KEY=your_openai_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_BASE=https://api.openai.com/v1

# Storage Configuration
# === LOCAL DEV (Azurite) ===
# For local dev, point AZURE_STORAGE_CONNECTION_STRING at Azurite (run scripts/azurite/start-azurite.ps1).
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=<AZURITE_DEFAULT_ACCOUNT_KEY>;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;QueueEndpoint=http://127.0.0.1:10001/devstoreaccount1;
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_QUEUE_NAME=indexing-jobs
AZURE_STORAGE_QUEUE_VISIBILITY_TIMEOUT_SECONDS=300
AZURE_STORAGE_QUEUE_POLL_INTERVAL_SECONDS=5
AZURE_STORAGE_QUEUE_DEQUEUE_BATCH_SIZE=4
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_USE_MANAGED_IDENTITY=false
AZURE_MANAGED_IDENTITY_CLIENT_ID=
AZURE_KEY_VAULT_URL=
AZURE_KEY_VAULT_GRAPHRAG_API_KEY_SECRET_NAME=
AZURE_KEY_VAULT_OPENAI_API_KEY_SECRET_NAME=
AZURE_KEY_VAULT_GOOGLE_API_KEY_SECRET_NAME=
AZURE_KEY_VAULT_TAVILY_API_KEY_SECRET_NAME=
AZURE_KEY_VAULT_STORAGE_CONNECTION_STRING_SECRET_NAME=
AZURE_KEY_VAULT_STORAGE_ACCOUNT_KEY_SECRET_NAME=
AZURE_KEY_VAULT_SEARCH_API_KEY_SECRET_NAME=
AZURE_KEY_VAULT_COSMOS_CONNECTION_STRING_SECRET_NAME=
AZURE_KEY_VAULT_COSMOS_KEY_SECRET_NAME=
AZURE_COSMOS_CONNECTION_STRING=
AZURE_COSMOS_ENDPOINT=
AZURE_COSMOS_KEY=
AZURE_COSMOS_CONNECTION_TIMEOUT_SECONDS=15
AZURE_COSMOS_RETRY_TOTAL=9
AZURE_COSMOS_RETRY_BACKOFF_MAX_SECONDS=30
AZURE_COSMOS_RETRY_FIXED_INTERVAL_MS=0
AZURE_COSMOS_RETRY_CONNECT=3
AZURE_COSMOS_RETRY_READ=3
AZURE_COSMOS_RETRY_STATUS=9
AZURE_COSMOS_RETRY_ON_STATUS_CODES=429,503
AZURE_COSMOS_DATABASE_NAME=gtog-control
AZURE_COSMOS_COLLECTIONS_CONTAINER=collections
AZURE_COSMOS_DOCUMENTS_CONTAINER=documents
AZURE_COSMOS_INDEXING_JOBS_CONTAINER=indexingJobs
AZURE_COSMOS_JOB_EVENTS_CONTAINER=jobEvents
AZURE_COSMOS_ARTIFACT_MANIFEST_CONTAINER=artifactManifest
AZURE_COSMOS_CONVERSATION_SESSIONS_CONTAINER=conversationSessions
AZURE_COSMOS_CONVERSATION_TURNS_CONTAINER=conversationTurns

# Indexing worker configuration
INDEXING_JOB_MAX_ATTEMPTS=3
INDEXING_WORKER_LEASE_DURATION_SECONDS=300
INDEXING_WORKER_HEARTBEAT_INTERVAL_SECONDS=30
INDEXING_WORKER_RECOVERY_INTERVAL_SECONDS=30

# Serving cache
SERVING_DATASET_CACHE_MAX_ENTRIES=96
SERVING_CACHE_WARM_ON_INDEX_COMPLETE=true

# Conversation memory
CONVERSATION_LEGACY_PAYLOAD_ENABLED=true
CONVERSATION_TURN_TTL_DAYS=30
CONVERSATION_SESSION_TTL_DAYS=90
CONVERSATION_SUMMARIZE_USER_TURN_THRESHOLD=8
CONVERSATION_RECENT_USER_TURNS=3
CONVERSATION_TURN_MAX_CHARS=4000
CONVERSATION_SUMMARY_MAX_CHARS=2000

# Model Configuration
DEFAULT_CHAT_MODEL=gpt-4o-mini
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small

# AI Guardrails
AI_GUARDRAILS_ENABLED=false
AI_GUARDRAILS_MODE=shadow
AI_GUARDRAILS_FAIL_MODE=open
AI_GUARDRAILS_CONFIG_PATH=backend/app/guardrails
AI_GUARDRAILS_TIMEOUT_SECONDS=8
AI_GUARDRAILS_LOG_DECISIONS=true
AI_GUARDRAILS_BLOCK_WEB_ON_SENSITIVE_QUERY=true
AI_GUARDRAILS_RETURN_METADATA=false

# Server Configuration
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
REQUIRE_EDGE_AUTH=false
EDGE_ORIGIN_SECRET=
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120
